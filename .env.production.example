# Copy to .env.production on the server (chmod 600). Placeholders only.

# Real domain: Caddy obtains HTTPS automatically (DNS must point at the VPS).
SITE_ADDRESS=beta.example.com
PUBLIC_ORIGIN=https://beta.example.com
# Local production test instead (no domain, plain HTTP on this machine only):
# SITE_ADDRESS=http://localhost
# PUBLIC_ORIGIN=http://localhost:8080
# PUBLISH_HTTP=127.0.0.1:8080
# PUBLISH_HTTPS=127.0.0.1:8443

DB_PASSWORD=replace-with-a-long-random-password
# One hosted provider for all AI workflows. Use the matching project key.
AI_PROVIDER=gemini
AI_API_KEY=replace-with-your-selected-provider-key
# AI_REQUEST_TIMEOUT_MS=120000
# Hosted AI usage limits (days end at midnight Vietnam time):
# AI_DAILY_USER_LIMIT=100
# AI_DAILY_GLOBAL_LIMIT=500
# AI_MAX_CONCURRENT=4
# Job-link import sources. ITviec is always on. TopCV/VietnamWorks link fetching
# is off (0) until their content-use permission is resolved; set 1 only with
# that permission. Users can still import from them via paste or upload.
# JOB_URL_FETCH_TOPCV=0
# JOB_URL_FETCH_VIETNAMWORKS=0
# Comma-separated accounts allowed to use /admin. Empty = no web admin (CLI still works).
# ADMIN_EMAILS=admin@example.com
