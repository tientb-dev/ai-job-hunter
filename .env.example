# Copy to .env and replace the password. Local development only.
NODE_ENV=development
API_PORT=3000
DB_ENV=development
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ai_job_hunter_dev
DB_USER=ai_job_hunter_dev
DB_PASSWORD=replace-with-a-unique-development-password

# Internal AI provider; startup and unit tests do not contact Ollama.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
AI_REQUEST_TIMEOUT_MS=120000
# To use hosted AI, set AI_PROVIDER to openai or gemini above and supply its key.
# Hosted prompts can include CV, job, and interview answer text.
# AI_API_KEY=replace-with-your-selected-provider-key
# Optional local speech-to-text (PR16): absolute paths to a whisper.cpp
# whisper-cli binary and an English GGML model, both outside the repository.
# Leave unset to use ~/whisper.cpp/build/bin/whisper-cli and
# ~/whisper.cpp/models/ggml-base.en.bin when present; otherwise transcription is
# unavailable and typing still works.
STT_BIN=
STT_MODEL=

# Optional one-link JD import (PR87). ITviec is always on. TopCV and
# VietnamWorks fetching stay off (0/unset) until their content-use review is
# resolved; set to 1 only for local or approved deployments.
JOB_URL_FETCH_TOPCV=0
JOB_URL_FETCH_VIETNAMWORKS=0

# Comma-separated accounts allowed to use /admin. Empty = no web admin.
ADMIN_EMAILS=
